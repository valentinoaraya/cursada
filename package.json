{
  "name": "cursada",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @cursada/api",
    "dev:web": "npm run dev -w @cursada/web",
    "test": "npm run test --workspaces --if-present",
    "test:bdd": "cucumber-js",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.7.0",
    "@cursada/core": "*",
    "tsx": "^4.23.15"
  }
}
